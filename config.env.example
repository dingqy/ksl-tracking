# ksl-watch configuration.  Keep this file private:  chmod 600 config.env
# NOTE: no inline comments below -- this file is parsed by both `sh` and
# Docker Compose `env_file`, and older Compose keeps trailing text as part of
# the value.  Comments live on their own lines.

# ---------------------------------------------------------------- what to watch
# tixplus tour id(s), comma-separated
KSL_TOURS=14584
# how many tickets you need
KSL_WANT=2
# serial = one lot of N consecutive seats (recommended for "2 together")
# total  = N tickets listed for the same seat type, possibly as singles
# any    = fire on anything at all appearing
KSL_MODE=serial
# sweep pacing. The gap between sweeps is drawn at random from
# [KSL_INTERVAL_MIN, KSL_INTERVAL_MAX] so the traffic is not metronomic.
# 50-75 averages ~62s, i.e. still roughly one sweep per minute.
KSL_INTERVAL_MIN=50
KSL_INTERVAL_MAX=75
# 5% of sweeps additionally idle up to KSL_LONG_PAUSE_MAX seconds
KSL_LONG_PAUSE_CHANCE=0.05
KSL_LONG_PAUSE_MAX=150
# cron (--once) fires exactly at :00; wait a random 0-45s so it does not
KSL_STAGGER_MAX=45
# if tixplus returns 403/429/503: pause this long, doubling per strike, capped
KSL_BAN_PAUSE_SEC=600
KSL_BAN_BACKOFF_MAX_SEC=7200
# re-nag every N minutes while a match is still open (0 = alert once)
KSL_REPEAT_MIN=30
# also alert on listings smaller than KSL_WANT (1 = yes)
KSL_NOTIFY_LOW=1
# warn N hours before the apply deadline
KSL_DEADLINE_WARN=72,24,3
# alert if N polls in a row fail
KSL_FAIL_ALERT_AFTER=10
# paths -- leave commented to keep state/log next to the script.
# Docker overrides these to /data automatically.
#KSL_LOG=/volume1/docker/ksl-watch/ksl.log
#KSL_STATE=/volume1/docker/ksl-watch/state.json

# ------------------------------------------------- notifications: pick one
# Bark (iOS push) -- same key/endpoint style as aa_tracker.push_bark.
# urgent alerts (a matching lot) arrive with the alarm sound + timeSensitive;
# routine ones are silent banners; health notices are Notification Center only.
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_GROUP=KSL-Trade
BARK_SOUND=alarm

# Telegram -- @BotFather gives the token, @userinfobot gives the chat id
#TELEGRAM_BOT_TOKEN=123456:ABC-DEF
#TELEGRAM_CHAT_ID=123456789

# Discord -- Server Settings > Integrations > Webhooks > New Webhook
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ntfy -- install the app, subscribe to a LONG RANDOM topic (the topic is the secret)
#NTFY_TOPIC=ksl-2026-tokyo-change-me-8f3ka9wq
#NTFY_SERVER=https://ntfy.sh
#NTFY_PRIORITY=high
#NTFY_TOKEN=

# Generic JSON webhook (Home Assistant, IFTTT, your own receiver)
#WEBHOOK_URL=https://example.com/hook

# Email
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_TLS=1
#SMTP_USER=you@example.com
#SMTP_PASS=app-specific-password
#SMTP_FROM=you@example.com
#SMTP_TO=you@example.com
