# Everything that runs on the NAS must keep LF endings. CRLF in run.sh gives
# "bad interpreter: /bin/sh^M"; CRLF in config.env leaks \r into values.
* text=auto eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
*.example   text eol=lf
Dockerfile  text eol=lf
*.service   text eol=lf
